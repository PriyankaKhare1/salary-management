default: &default
  adapter: postgresql
  encoding: unicode
  pool: <%= ENV.fetch("RAILS_MAX_THREADS") { 5 } %>
  host: localhost
  port: 5432
  username: <%= ENV.fetch("DB_USERNAME", "postgres") %>
  password: <%= ENV.fetch("DB_PASSWORD", "your_password_here") %>

development:
  <<: *default
  database: salary_management_development

test:
  <<: *default
  database: salary_management_test

production:
  <<: *default
  database: salary_management_production
  username: salary_management
  password: <%= ENV["SALARY_MANAGEMENT_DATABASE_PASSWORD"] %>
